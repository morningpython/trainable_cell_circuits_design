복사
import tellurium as te
ant = '''
model transcription_learning
  species V, Hmon, C, Htot;
  k_dV = 0.1; k_dH = 0.01; k_bind = 1.0; k_unbind = 0.1;
  gamma = 1e-3; eta = 1e-2;
  sV = 1.0; sH = 0.01;
  R1: -> V; sV - k_dV*V;
  R2: -> Hmon; sH - k_dH*Hmon;
  R3: V + Hmon -> C; k_bind*V*Hmon;
  R4: C -> V + Hmon; k_unbind*C;
  R5: -> Htot; -gamma*Htot + eta*0;
end
'''
r = te.loadAntimonyModel(ant)
r.simulate(0, 1000, 200)
r.plot()
